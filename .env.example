KAMSTRUP_MODE=sim
KAMSTRUP_BASE_URL=https://check.kamstrup.com/DeviceMonitorService/rest/devicedata
KAMSTRUP_SERIAL_FIELDS=SerialNumber
POLL_MIN_INTERVAL_S=5
WARN_AFTER_S=60
MEASURE_WINDOW_S=35
LOCK_TTL_S=120
# AUTH_MODE: implicit "none" pe simulator, "token" (cuplare) cu KAMSTRUP_MODE=live
# AUTH_MODE=token
LINKIQ_TOKENS=
# Praguri PROVIZORII (dBm) - de calibrat cu date din teren
RSSI_QUICK_CONFIRM_DBM=-80
RSSI_GOOD_DBM=-95
RSSI_MARGINAL_DBM=-110
PRIMARY_DEGRADATION_MAX_DB=6
